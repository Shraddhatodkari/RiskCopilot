# Copy this file to .env and fill in real values. Never commit .env.
#
# SEC EDGAR requires a descriptive User-Agent identifying you and a contact
# email, per https://www.sec.gov/os/webmaster-faq#developers . Requests
# without this header are rejected outright.
SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"

# Free registration at https://fred.stlouisfed.org/docs/api/api_key.html
# Only needed from Phase 2 onward (macro context signals).
FRED_API_KEY=

# --- Phase 3 qualitative narrative layer: LLM backend ---
#
# Default (ADR-011): a locally-run Ollama model. Zero API cost, no API key,
# nothing leaves your machine. Both have working defaults — you only need
# to set these if Ollama runs somewhere non-default, or you want a
# different model than llama3.2:latest.
#   1. Install Ollama: https://ollama.com
#   2. ollama pull llama3.2:latest
#   3. ollama serve   (if not already running)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# How long to wait for a response (seconds) before giving up. 300s by
# default: on a CPU-only machine, the *first* call after `ollama serve`
# starts pays the cost of loading the model into RAM before generating
# anything, which alone can exceed the old 120s default. Raise this
# further if your machine is slower, or lower it once you know your real
# generation time. Only needed if the default (300) isn't enough/is too much.
OLLAMA_TIMEOUT_SECONDS=300

# How long Ollama keeps the model loaded in memory after a request, so the
# *next* call doesn't pay the load-time cost again. Accepts Ollama's own
# duration syntax (e.g. "10m", "1h", "-1" for indefinitely). Only needed if
# you want something other than the default (30m).
OLLAMA_KEEP_ALIVE=30m

# Optional alternative backend (not used by default anywhere in this
# project — see src/agentic/llm_client.py's AnthropicLLMClient). Only
# relevant if you choose to construct AnthropicLLMClient yourself instead
# of the default OllamaLLMClient.
ANTHROPIC_API_KEY=
